# ═══════════════════════════════════════════════════════════════
# 3MH STORE — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم:  cp .env.example .env
# ملاحظة: الخادم يقبل أيضاً أسماء VITE_* المقابلة (VITE_GITHUB_OWNER … إلخ)،
#         وكذلك PLISIO_API_KEY بديلاً عن PLISIO_KEY.
# ═══════════════════════════════════════════════════════════════

# ── قاعدة البيانات: مستودع GitHub خاص يحوي data/*.json ──
# مالك المستودع (مستخدم أو منظمة)
GITHUB_OWNER=
# اسم المستودع (يجب أن يكون خاصاً)
GITHUB_REPO=
# الفرع المستخدم (افتراضي: main)
GITHUB_BRANCH=main
# fine-grained token بصلاحيات Contents: Read & Write على هذا المستودع فقط
GITHUB_TOKEN=

# ── الأمان والجلسات ──
# سر توقيع HMAC لتوكنات جلسات المشرف والعملاء — مطلوب.
# بدونه يولّد الخادم سراً عشوائياً لكل عملية تشغيل (مع تنبيه في السجل)،
# وتُلغى كل الجلسات عند إعادة التشغيل.
API_SECRET=
# رقم دخول لوحة التحكم #/admin — لا يوجد افتراضي؛ القيمة الفارغة تعني
# أن الخادم يرفض تسجيل دخول المشرف نهائياً.
ADMIN_PIN=
# مفتاح تشفير AES-GCM لروابط تسليم الأصول — يجب أن يطابق المفتاح الذي
# شُفّر به حقول access في data/products.json (انظر npm run seed:assets).
ASSET_SECRET=

# ── بوابة الدفع Plisio ──
# مفتاح حساب Plisio — بدونه تفشل جميع عمليات إنشاء فواتير الدفع.
PLISIO_KEY=

# ── الموقع والخادم ──
# العنوان الأساسي للمتجر — يُستخدم في روابط العودة من بوابة الدفع
# (افتراضي: https://3mh-store.pages.dev)
SITE_URL=
# منفذ خادم scripts/server.mjs (افتراضي: 7860)
PORT=

# ── الواجهة (يقرأها Vite وقت التشغيل/البناء) ──
# تجاوز عنوان الـ API في المتصفح. اتركه فارغاً للسلوك الافتراضي:
#   أسماء *.hf.space → https://3mh-store.pages.dev ، غيرها → النطاق الحالي.
VITE_API_BASE=
